diff --git pristine/src/deflate.rs patched/src/deflate.rs
index 48fb336..b404c9f 100644
--- pristine/src/deflate.rs
+++ patched/src/deflate.rs
@@ -171,6 +171,13 @@ impl<W: Write> Write for DeflateEncoder<W> {
 
 impl<W: Write> Drop for DeflateEncoder<W> {
     fn drop(&mut self) {
+        // Oxidrop patch: while unwinding (Oxidrop stops a file by unwinding out of the
+        // compression), finishing would compress the whole pending chunk again, and nobody
+        // wants the output. See vendor/README.md.
+        #[cfg(feature = "std")]
+        if std::thread::panicking() {
+            return;
+        }
         self.__finish().ok();
     }
 }
